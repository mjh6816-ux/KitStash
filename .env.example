# Supabase - KitStash (copy to .env.local for local dev)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SERVER ONLY - never set as NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase auth user UUID (single-user app). Get it from Supabase Dashboard > Authentication > Users
# Falls back to the original dev UUID if not set.
SUPABASE_USER_ID=a8e4287a-040b-41dd-ba45-87f6a3c07395

# Optional shared password gate (recommended for personal deployments on free Hobby plans).
# Set the same value in Vercel Environment Variables (as a regular var, not NEXT_PUBLIC).
# When set, users must enter this password to access the app from any device.
# Works alongside (or instead of) Vercel Password Protection.
# Leave blank to disable the gate.
SITE_PASSWORD=your-strong-unique-password-here

